// prisma/schema.prisma

// Define o banco de dados (PostgreSQL) e o ORM (Prisma)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Lê a URL do seu arquivo .env
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------
// DOMÍNIO: AUTH/BARBEARIA (Foco da Pessoa 1 - João)
// ----------------------------------------------------------------------

// Tabela 1: USUARIO (Simplificado)
model Usuario {
  id          String   @id @default(uuid())
  email       String   @unique // Único
  senha_hash  String   // Salva o hash do Bcrypt
  nome        String   
  telefone    String   
  
  // Simplificado: 'cliente' ou 'admin' (admin = dono/barbeiro)
  tipo        String   @default("cliente") 
  
  // A qual barbearia este admin/barbeiro pertence
  barbeariaId String?   
  barbearia   Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  // Relações que o Neto irá usar:
  agendamentosCliente Agendamento[] @relation("AgendamentosDoCliente")
  
  @@map("usuarios") 
}

// Tabela 2: BARBEARIA (O Tenant - Simplificado)
model Barbearia {
  id          String   @id @default(uuid())
  nome        String   
  endereco    String   
  telefone    String   
  
  // Configurações
  tempo_min_antecedencia Int @default(60) // em minutos

  // Relação 1:N (Uma barbearia tem muitos usuários admin/barbeiro)
  usuarios     Usuario[] 
  
  // Relações do Neto
  servicos     Servico[]
  barbeiros    Barbeiro[]
  agendamentos Agendamento[]

  createdAt    DateTime @default(now())

  @@map("barbearias")
}

// ----------------------------------------------------------------------
// DOMÍNIO: AGENDAMENTO (Foco do Neto)
// ----------------------------------------------------------------------

// Requisito: Gerenciamento de Serviços (Nome, Preço)
model Servico {
  id          String   @id @default(uuid())
  nome        String   
  preco       Float    
  duracao_min Int      // Duração em minutos (Ex: 30)

  // Chave do Multi-Tenancy (Obrigatório!)
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeariaId String

  agendamentos Agendamento[]

  @@map("servicos")
}

// Representa o profissional (Simplificado para o MVP)
model Barbeiro {
  id            String   @id @default(uuid())
  nome          String
  especialidade String?

  // Chave do Multi-Tenancy (Obrigatório!)
  barbearia     Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeariaId   String
  
  agendamentos  Agendamento[]

  @@map("barbeiros")
}

// Requisito: Agendamento de Serviços
model Agendamento {
  id          String   @id @default(uuid())
  dataHora    DateTime // Hora de início
  
  // =======================================================
  // || CAMPO NOVO (CRÍTICO PARA ANTI-DOUBLE BOOKING) ||
  // =======================================================
  dataHoraFim DateTime  

  // Des-scoping: Status 'pendente' removido. Agendamento é 'confirmado' direto.
  status      String   @default("confirmado") 

  // Chave do Multi-Tenancy (Obrigatório!)
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeariaId String

  // Relações
  cliente     Usuario  @relation("AgendamentosDoCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId   String
  
  barbeiro     Barbeiro @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)
  barbeiroId   String

  servico     Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  servicoId   String

  createdAt   DateTime @default(now())
  @@map("agendamentos")
}