.env 

# Conexão direta com o seu banco PostgreSQL local
# IMPORTANTE: Mude 'postgres' (usuário), 'sua_senha' e 'shaveasy' (nome do banco)
DATABASE_URL="postgresql://postgres:senhagre@localhost:5432/shaveasy?schema=public"

# Chave Secreta para gerar e validar os Tokens JWT (Mude para algo complexo!)
JWT_SECRET="shaveasygre"

# Porta do servidor Node.js
PORT=3333